; mightyweenie audio extension: MwChips (ymfm YM2612 + our SN76489).
; Sources: native/mw_audio. Libraries (built, not committed): tools/bin/build-audio
; (Linux) and tools/bin/build-audio --windows. Notices: THIRD_PARTY_NOTICES.txt.

[configuration]

entry_symbol = "mw_audio_init"
compatibility_minimum = "4.7"

[libraries]

linux.debug.x86_64 = "res://addons/mw_audio/bin/libmw_audio.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/mw_audio/bin/libmw_audio.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/mw_audio/bin/libmw_audio.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/mw_audio/bin/libmw_audio.windows.template_release.x86_64.dll"
