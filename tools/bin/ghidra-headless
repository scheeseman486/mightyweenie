#!/usr/bin/env bash
# Ghidra analyzeHeadless with the pinned JDK.
#   tools/bin/ghidra-headless re/ghidra/project MLH -process -noanalysis -postScript ...
source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"
mw_require "$MW_TOOLS/ghidra/support/analyzeHeadless" ghidra; mw_require "$MW_TOOLS/jdk/bin/java" jdk
export JAVA_HOME="$MW_TOOLS/jdk" PATH="$MW_TOOLS/jdk/bin:$PATH"
exec "$MW_TOOLS/ghidra/support/analyzeHeadless" "$@"
