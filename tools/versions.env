# Pinned toolchain versions. tools/setup/fetch_tools.sh reads this file.
# Bump a version here, update its checksum, and re-run the fetch script.

# Godot editor/runtime (must match the version the user's editor runs)
GODOT_VERSION=4.7.1
GODOT_URL=https://github.com/godotengine/godot/releases/download/4.7.1-stable/Godot_v4.7.1-stable_linux.x86_64.zip
GODOT_SHA512=4ccdab7a48eeccbe8819a2fc1f6262f8d72065d98601bcb3743fcbd7ebd39f373758a788ee3293a05ec5b2c48538266c437404312e372225cd2df273945a2de9
# Godot export templates (all platforms; only the Windows x86_64 ones are
# installed, into tools/godot/editor_data/export_templates - tools/bin/export-windows)
GODOT_TEMPLATES_URL=https://github.com/godotengine/godot/releases/download/4.7.1-stable/Godot_v4.7.1-stable_export_templates.tpz
GODOT_TEMPLATES_SHA512=afcc83d8d3d298038f19c58744a0d660fa75dd4baa33cb55d1011bb2565a2a8c2381728924564cb909e37c205a23f21b521b23bd057993afd43ae4da0b2f9d47

# Eclipse Temurin JDK 21 (required by Ghidra 12.x)
JDK_VERSION=21.0.12.1+1
JDK_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_x64_linux_hotspot_21.0.12.1_1.tar.gz
JDK_SHA256=ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94

# Ghidra (NSA) - static analysis
GHIDRA_VERSION=12.1.4
GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.4_build/ghidra_12.1.4_PUBLIC_20260921.zip
GHIDRA_SHA256=ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db

# BlastEm - interactive debugger emulator (GPL-3, used as a tool only)
BLASTEM_VERSION=1.0.0
BLASTEM_URL=https://www.retrodev.com/blastem/nightlies/blastem64-1.0.0.tar.gz
# upstream publishes no checksum; this pins the file we first fetched
BLASTEM_SHA256=3cc771d326f45466536bb89a2e7a9468fdde518c675af29e14d991c0d56cbfee

# Godot addons (vendored into game/addons by fetch_tools.sh)
GUT_VERSION=v9.7.1
GUT_URL=https://github.com/bitwes/Gut/archive/refs/tags/v9.7.1.tar.gz
GUT_SHA256=6da99c4e9228d9bec3fb4bd1730a487770a989f0f511dac82a2897a964613385
# Godot LSP / DAP ports for this project's editor (defaults 6005/6006 are
# taken by whichever editor started first).
MW_LSP_PORT=6015
MW_DAP_PORT=6016

# Audio GDExtension (game/addons/mw_audio, sources in native/mw_audio; built by
# tools/bin/build-audio, fetched by tools/setup/fetch_tools.sh audio [zig]).
# godot-cpp 10.x builds for several Godot versions; we use its api_version 4.7
# (its extension_api-4-7.json and gdextension_interface.json are identical to
# what Godot 4.7.1 dumps with --dump-extension-api / --dump-gdextension-interface-json).
GODOT_CPP_VERSION=10.0.0-stable
GODOT_CPP_API=4.7
GODOT_CPP_URL=https://github.com/godotengine/godot-cpp/archive/refs/tags/10.0.0-stable.tar.gz
GODOT_CPP_SHA256=ebbf64f0f8f8b8b66bc4bc4d3797db97f95b19cf0dfb5b3f8cf56683d9df7db4
# ymfm (Aaron Giles, BSD-3-Clause): the YM2612 core. No releases; pinned to a commit.
YMFM_VERSION=81aec25ccbb98f4873a255f7551ac4dadac59b4a
YMFM_URL=https://github.com/aaronsgiles/ymfm/archive/81aec25ccbb98f4873a255f7551ac4dadac59b4a.tar.gz
YMFM_SHA256=9bcf001b30f53754c49cf2fb864792a64702b8aeebb105baa908ad5dd33f443f
# Zig (MIT): its bundled clang + MinGW-w64 headers/libs cross-compile the
# Windows DLL from Linux without root (tools/bin/build-audio --windows).
ZIG_VERSION=0.16.0
ZIG_URL=https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz
ZIG_SHA256=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
